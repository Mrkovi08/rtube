post_install() {
  echo ">> Rtube installed / telepítve. Run / indítás: rtube   (Winamp skin / kinézet: rtube --winamp)"
  echo ">> UI language follows the system (Hungarian/English); force with / kényszerítés: RTUBE_LANG=en|hu"
  echo ">> DMS bar widget (optional / opcionális):"
  echo "   mkdir -p ~/.config/DankMaterialShell/plugins && cp -r /usr/share/rtube/dms-plugin ~/.config/DankMaterialShell/plugins/rtube"
}
post_upgrade() { post_install; }
